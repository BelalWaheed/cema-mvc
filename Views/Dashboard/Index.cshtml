@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <h1 class="fw-bold mb-5">Admin Dashboard</h1>

    <div class="row g-4">
        <!-- Movies Card -->
        <div class="col-md-4">
            <div class="card bg-dark border-secondary h-100 shadow hover-shadow transition-all">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-film display-4 text-danger mb-3"></i>
                    <h3 class="fw-bold">Movies</h3>
                    <p class="text-muted">Manage your movie library and posters.</p>
                    <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-light w-100 mt-3">Manage Movies</a>
                </div>
            </div>
        </div>

        <!-- Halls Card -->
        <div class="col-md-4">
            <div class="card bg-dark border-secondary h-100 shadow hover-shadow transition-all">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-door-open display-4 text-primary mb-3"></i>
                    <h3 class="fw-bold">Halls</h3>
                    <p class="text-muted">Configure cinema halls and seat layouts.</p>
                    <a asp-controller="Halls" asp-action="Index" class="btn btn-outline-light w-100 mt-3">Manage Halls</a>
                </div>
            </div>
        </div>

        <!-- Screenings Card -->
        <div class="col-md-4">
            <div class="card bg-dark border-secondary h-100 shadow hover-shadow transition-all">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-calendar-event display-4 text-success mb-3"></i>
                    <h3 class="fw-bold">Screenings</h3>
                    <p class="text-muted">Schedule showtimes and set prices.</p>
                    <a asp-controller="Screenings" asp-action="Index" class="btn btn-outline-light w-100 mt-3">Manage Screenings</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 p-5 bg-dark rounded border border-secondary text-center shadow">
        <h4 class="fw-bold">System Status</h4>
        <div class="d-flex justify-content-center gap-5 mt-4">
            <div>
                <div class="text-muted small">Server Time</div>
                <div class="fw-bold">@DateTime.Now.ToString("HH:mm:ss")</div>
            </div>
            <div>
                <div class="text-muted small">Seat Lock Status</div>
                <div class="text-success fw-bold">Active (Memory Cache)</div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        border-color: #dc2626 !important;
    }
    .transition-all {
        transition: all 0.3s ease;
    }
</style>
